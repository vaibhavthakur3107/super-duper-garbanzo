# ──────────────────────────────────────────────────────────────────────────────
# Cyber-Sentry AI – Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: ollama | openai | anthropic | openrouter
# If not set, auto-detected from available API keys in this order:
#   openrouter > openai > anthropic > ollama (local fallback)
LLM_PROVIDER=ollama

# ── Ollama (local, default) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# ollama pull llama3  (run this once to download the model)

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
# Also run:  pip install langchain-openai
OPENAI_API_KEY=sk-...

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
# Also run:  pip install langchain-anthropic
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenRouter (200+ models via one API) ─────────────────────────────────────
# Get your free key at https://openrouter.ai/keys
# Also run:  pip install langchain-openai   (same package as OpenAI)
OPENROUTER_API_KEY=sk-or-...
# Optional – shows up in your OpenRouter dashboard
OPENROUTER_SITE_URL=https://github.com/vaibhavthakur3107/super-duper-garbanzo
OPENROUTER_APP_TITLE=Cyber-Sentry AI

# ── Scope / Authorization ─────────────────────────────────────────────────────
# Comma-separated list of targets you are authorized to scan.
# The agent will refuse to scan anything NOT on this list.
AUTHORIZED_SCOPES=example.com,test.local,127.0.0.1,localhost

# ── Loot / Notes ─────────────────────────────────────────────────────────────
# Directory where findings, notes, and session data are saved
LOOT_DIR=./loot
SESSIONS_DIR=./sessions
